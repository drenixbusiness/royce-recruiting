# Where the board is stored. Pick ONE of these; with none set (and not on Vercel) it uses files in ./data.

# Upstash Redis — added automatically when you connect "Upstash for Redis" in Vercel → Storage
KV_REST_API_URL=
KV_REST_API_TOKEN=
# (UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN also work)

# Any other Redis server
# REDIS_URL=redis://user:password@host:6379

# On Vercel, how often screens check for changes, in milliseconds (default 3000, minimum 1000)
# SYNC_POLL_MS=3000
